# Copy to .env and fill in local paths. Never commit .env or credentials.

# Wholesale account credentials for headless login (required for npm run login
# and for automatic re-login when storageState expires). Never commit real values.
BRASTY_EMAIL=
BRASTY_PASSWORD=

# Path to the Brasty product CSV (EAN + product name columns auto-detected)
BRASTY_CSV_PATH=./sample-products.csv

# Playwright session file produced by `npm run login` (or by ensureSession)
STORAGE_STATE_PATH=./storageState.json

# Where downloaded originals go (EAN.jpg)
OUTPUT_DIR=./output

# Watermarked copies (originals are never overwritten)
WATERMARKED_DIR=./watermarked

# LPS logo for `npm run watermark`. Leave empty to no-op.
LOGO_PATH=./assets/lps-logo.png
LOGO_POSITION=bottom-right
LOGO_SCALE=0.18
LOGO_OPACITY=0.85

# Public URL base used by build-overrides (no trailing slash). Prefer LPS_MEDIA_BASE_URL;
# IMAGE_HOST_BASE_URL and PUBLIC_URL_BASE are aliases. Default in code: images.slilverbelt.xyz
LPS_MEDIA_BASE_URL=https://images.slilverbelt.xyz
# PUBLIC_URL_BASE=https://images.slilverbelt.xyz

# Merge target for EAN → URL map (relative to repo root or absolute)
IMAGE_OVERRIDES_PATH=../../../production-environment/sillage-core/data/image_overrides.json

# Append-only resume manifest (JSONL)
MANIFEST_PATH=./logs/manifest.jsonl

# Structured log file (also printed to stdout)
LOG_PATH=./logs/download.log

# Concurrency: pool of browser contexts. Keep at 1 on a small VPS (4 GB shared
# with WordPress / MariaDB / Valkey / Bun). Do not raise without measuring RAM.
CONCURRENCY=1

# Politeness delay between products within a context (ms). No busy-sleep elsewhere.
POLITENESS_DELAY_MS=1500

# Retries with exponential backoff for transient download / network failures
RETRY_COUNT=3
RETRY_BACKOFF_MS=1000

# Headless Chromium for login / investigate / download (no X server required)
HEADLESS=true

# Comma-separated EANs for `npm run investigate` (operator-supplied)
INVESTIGATE_EANS=

# Site base URL
BRASTY_BASE_URL=https://wholesale.brasty.com/

# Full-catalog crawl (`npm run crawl-catalog`): paginate B2B list rows.
# in_stock (~14k) first; out_of_stock; or all (in_stock then out_of_stock).
CATALOG_STOCK_FILTER=in_stock
# 1-based page override (when >1, ignores checkpoint page for that filter)
CATALOG_START_PAGE=1
# Cap pages for a trial (0 = no cap). 242 pages × ~60 rows ≈ IN STOCK catalog.
CATALOG_MAX_PAGES=0
CATALOG_CHECKPOINT_PATH=./logs/catalog-checkpoint.json
