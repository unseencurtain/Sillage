# Single env for the whole stack. Copy to production-environment/.env (gitignored).
#   cp .env.example .env

# ── Docker images ────────────────────────────────────────────────────────────
# Built/pushed by scripts/build-push-images.sh (namespace defaults to Docker Hub user).
SILLAGE_CORE_IMAGE=unseencurtain/sillage-core:latest
WORDPRESS_IMAGE=unseencurtain/sillage-wordpress:latest
MARIADB_IMAGE=mariadb:latest
VALKEY_IMAGE=valkey/valkey:8-alpine
LPS_MEDIA_IMAGE=nginx:alpine
CADDY_IMAGE=caddy:2-alpine

# ── Host paths (relative to this compose file unless absolute) ───────────────
DATA_DIR=./ecom_sites/data
FEEDSCRATCH_DIR=../.feedscratch
SILLAGE_LOGS_DIR=./sillage-core/logs
IMAGE_OVERRIDES_FILE=./sillage-core/data/image_overrides.json
MARIADB_CNF=./ecom_sites/config/mariadb.cnf
# VPS (~4 GB): MARIADB_CNF=./ecom_sites/config/mariadb.vps.cnf
LPS_MEDIA_NGINX_CONF=./ecom_sites/config/nginx-lps-media.conf
PHP_INI=./ecom_sites/config/php.ini
GATEWAY_CADDYFILE=./ecom_sites/config/Caddyfile.compose

# ── Published ports (loopback by default; VPS Caddy proxies to these) ────────
DB_BIND=127.0.0.1
DB_HOST_PORT=3307
ECOM_BIND=127.0.0.1
ECOM_PORT=104
MEDIA_BIND=127.0.0.1
MEDIA_PORT=105
SILLAGE_BIND=127.0.0.1
SILLAGE_PORT=4000
GATEWAY_PORT=80

# Local browser gateway on :80 — enable with: docker compose --profile local up -d
# COMPOSE_PROFILES=local

# ── Domains (VPS / public URLs) ──────────────────────────────────────────────
SHOP_DOMAIN=shop.example.com
DASH_DOMAIN=ops.example.com
IMAGES_DOMAIN=images.example.com
WP_BASE_URL=https://shop.example.com
# Fallback when sil_settings.image_cdn_base_url is unset:
LPS_MEDIA_BASE_URL=https://images.example.com

# ── MariaDB / WordPress ──────────────────────────────────────────────────────
MYSQL_ROOT_PWD=change-me
MYSQL_DB=earth
MYSQL_USER=lime
MYSQL_PWD=change-me

# ── sillage-core ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Compose overrides DB_HOST/REDIS_URL/FIXTURES_DIR inside containers.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=sillage
SILLAGE_DB_PASSWORD=change-me
SILLAGE_DB=sillage
WORDPRESS_DB=earth
WP_TABLE_PREFIX=wp_
DB_CONNECTION_LIMIT=10

SILLAGE_SHARED_SECRET=generate-a-long-random-hex-string

BEAUTYFORT_USER=
BEAUTYFORT_SECRET=
BEAUTYFORT_ENDPOINT=https://www.beautyfort.com/api/soap/v4
BEAUTYFORT_TEST_MODE=false

BTS_JWT_TOKEN=
BTS_BASE_URL=https://api.btswholesaler.com/v1/api
BTS_LANGUAGE=en-US

WHOLESALE_PERFUMES_USER=
WHOLESALE_PERFUMES_TOKEN=
WHOLESALE_PERFUMES_CATALOG_URL=https://www.wholesale-perfumes.eu/xml/catalog/LovelyXml/en
WHOLESALE_PERFUMES_STOCK_URL=https://www.wholesale-perfumes.eu/xml/store/LovelyXml/EUR
WHOLESALE_PERFUMES_API_BASE_URL=https://www.wholesale-perfumes.eu/api/v1

BRASTY_PRODUCT_FEED_URL=
BRASTY_AVAILABILITY_FEED_URL=

DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=generate-another-long-random-hex-string

FIXTURES_DIR=../.feedscratch
REDIS_URL=redis://127.0.0.1:6379
