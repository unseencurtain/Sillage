# Offline image enrichment / Ocean + Brasty feed downloads.
# Copy to .env and fill in. Never commit .env.

# wholesale-perfumes.eu — HTTP Basic (email + API token from user settings)
OCEAN_USER=
OCEAN_TOKEN=
OCEAN_CATALOG_URL=https://www.wholesale-perfumes.eu/xml/catalog/LovelyXml/en
OCEAN_STOCK_URL=https://www.wholesale-perfumes.eu/xml/store/LovelyXml/EUR

# Brasty — paste the full authenticated feed download URLs (include hash)
BRASTY_PRODUCT_FEED_URL=
BRASTY_AVAILABILITY_FEED_URL=
