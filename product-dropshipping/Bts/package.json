{
  "name": "bts-dropship-router",
  "version": "1.0.0",
  "description": "Multi-vendor dropshipping router — BTS Wholesaler & BeautyFort SDK + storefront",
  "module": "src/server/app.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/server/app.ts",
    "start": "bun run src/server/app.ts",
    "sync": "bun run scripts/sync.ts",
    "sync:delta": "bun run scripts/sync.ts --delta",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "live-test": "bun run scripts/live-test.ts",
    "live-test:orders": "bun run scripts/live-test.ts --orders"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "bun-types": "latest"
  }
}
